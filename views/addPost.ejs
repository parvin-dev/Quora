<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Post - Quora</title>

    <link rel="stylesheet" href="/addPost.css">
</head>

<body>

    <!-- Header -->

    <header class="header">

        <div class="logo">
            Quora
        </div>

        <button class="back-btn" onclick="window.location.href='/posts'">
            ← Back
        </button>

    </header>


    <!-- Main -->

    <main class="main">

        <div class="form-card">

            <h2>Add Post</h2>

            <form action="/posts" method="POST">

                <div class="form-group">

                    <label for="author">
                        Your Name
                    </label>

                    <input
                        type="text"
                        id="author"
                        name="author"
                        placeholder="Enter your name"
                    >

                </div>


                <div class="form-group">

                    <label for="question">
                        Question
                    </label>

                    <textarea
                        id="question"
                        name="question"
                        placeholder="Write your question..."
                        rows="6"
                    ></textarea>

                </div>


                <button type="submit" class="add-btn">
                    Add Post
                </button>

            </form>

        </div>

    </main>

</body>

</html>